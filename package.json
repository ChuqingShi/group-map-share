{
  "name": "group-map-share",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit -p . && vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:e2e": "tsc --noEmit -p e2e",
    "e2e": "npm run build && node --test --test-concurrency=1 e2e/*.e2e.ts",
    "check": "npm run typecheck && npm test && npm run e2e"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "maplibre-gl": "^6.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
